
[program:octane_staging]
command=php {{ stream_delta_staging_install_dir }}/current/artisan octane:start --port={{ stream_delta_staging_octane_port }}
user=stream-delta
autostart=true
autorestart=true
stdout_logfile={{ stream_delta_staging_install_dir }}/current/storage/logs/octane_stdout.log
stderr_logfile={{ stream_delta_staging_install_dir }}/current/storage/logs/octane_stderr.log
; Octane runs FrankenPHP as a child of `php artisan octane:start`. Without
; stopasgroup/killasgroup, supervisor treats the program as stopped once the
; php parent exits, while frankenphp can still be shutting down and holding
; its ports, so an immediate restart fails its port check ("Port 2019 is
; already in use"). Signal the whole group and wait for it to exit, and allow
; more start retries so a briefly busy port can't leave the site down.
stopasgroup=true
killasgroup=true
stopwaitsecs=30
startretries=10


[program:reverb_staging]
command=php {{ stream_delta_staging_install_dir }}/current/artisan reverb:start --host="127.0.0.1" --port={{ stream_delta_staging_reverb_port }}
autostart=true
autorestart=true
user=stream-delta
redirect_stderr=true
stdout_logfile={{ stream_delta_staging_install_dir }}/current/storage/logs/reverb_stdout.log


