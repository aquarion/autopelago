# {{ ansible_managed }}

server {
  listen 80;
  listen [::]:80;
  server_name socksandpuppets.com *.socksandpuppets.com;
  add_header X-WhyAmI "socksandpuppets redirect";
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl proxy_protocol;
  listen [::]:443 ssl proxy_protocol;
  server_name socksandpuppets.com *.socksandpuppets.com;
  include /etc/nginx/snippets/ssl/socksandpuppets_ssl.conf;

  error_log /var/log/nginx/socksandpuppets.error.log;
  access_log /var/log/nginx/socksandpuppets.access.log;

  add_header X-WhyAmI socksandpuppets;

  # Static content, proxied to the dedicated web_ahdok Apache sidecar
  # (mod_autoindex + AllowOverride Indexes) rather than served via nginx's
  # own "root" - the site's .htaccess relies on Apache-specific fancy
  # directory listing that nginx has no equivalent for.
  location / {
    proxy_pass http://127.0.0.1:4081;
    include /etc/nginx/snippets/proxy_params.nginx.conf;
  }

  include /etc/nginx/snippets/errors.conf;
  client_max_body_size 100M;
}
