# Docker Compose file for SFTP service
# {{ ansible_managed }}
name: SFTP Docker Service
services:
  sftp:
    image: atmoz/sftp
    ports:
        - "2222:22"
    volumes:
        - ./etc/users.conf:/etc/sftp/users.conf:ro
        - ./keys/ssh_host_ed25519_key:/etc/ssh/ssh_host_ed25519_key
        - ./keys/ssh_host_rsa_key:/etc/ssh/ssh_host_rsa_key
        - ./bin/bind_mounts.sh:/etc/sftp.d/bind_mounts.sh:ro
        - "{{ docker_root }}/sftp/home:/home:rw"
{% for username, mounts in firth_sftp_docker_bind_mounts.items() %}
{% for mount in mounts %}
        - {{ mount.source }}:/home/{{ username }}/{{ mount.target }}{% if mount.read_only is defined and mount.read_only %}:ro{% endif %}

{% endfor %}
{% endfor %}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - firth_services
    restart: unless-stopped
{% for username, site in firth_sftp_docker_web_sites.items() %}
{% if site.backend | default('fpm') == 'apache' %}

  web_{{ username }}:
    image: "{{ site.apache_image | default('httpd:2.4-alpine') }}"
    ports:
      - "127.0.0.1:{{ site.port }}:80"
    volumes:
      - {{ docker_root }}/sftp/home/{{ username }}/{{ site.web_domain }}:/usr/local/apache2/htdocs:rw
      - {{ docker_root }}/sftp/phpfpm/{{ username }}.conf:/usr/local/apache2/conf/httpd.conf:ro
    networks:
      - firth_services
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% else %}

  phpfpm_{{ username }}:
    image: "{{ site.php_image | default('php:8.3-fpm-alpine') }}"
    volumes:
      - {{ docker_root }}/sftp/home/{{ username }}/{{ site.web_domain }}:/var/www/html:rw
      - {{ docker_root }}/sftp/phpfpm/{{ username }}.conf:/usr/local/etc/php-fpm.d/www.conf:ro
      - {{ docker_root }}/sftp/run:/run/phpfpm:rw
    networks:
      - firth_services
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% endif %}
{% endfor %}

networks:
  firth_services:
    external: true
    name: "{{ firth_services_docker_network | default('firth_services') }}"
