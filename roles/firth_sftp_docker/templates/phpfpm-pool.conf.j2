; PHP-FPM pool for {{ user.name }}
; {{ ansible_managed }}
; Pool must be named "www", not "{{ user.name }}": the base php-fpm-alpine
; image ships /usr/local/etc/php-fpm.d/zz-docker.conf with an empty "[www]"
; section (no directives, kept for backwards compatibility). Since pool
; sections with the same name across included files merge, naming this
; pool "www" merges harmlessly into that empty section. Naming it anything
; else leaves zz-docker.conf's empty "[www]" as a second, distinct pool
; with no "user" directive, which fails FPM startup for the whole process.
; Safe to reuse "www" across every site: each site gets its own dedicated
; phpfpm_<user> container, so there's no cross-site collision.
[www]
user = www-data
group = www-data
listen = /run/phpfpm/{{ user.name }}.sock
listen.mode = 0666

pm = dynamic
pm.max_children = 5
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3

php_admin_value[error_log] = /proc/self/fd/2
php_admin_flag[log_errors] = on
