; PHP-FPM pool for {{ user.name }}
; {{ ansible_managed }}
; Pool must be named "www" - the base php-fpm-alpine image's zz-docker.conf
; overrides settings on a pool named "www"; any other name here leaves that
; override creating a second, empty pool with no "user" directive, which
; fails FPM startup.
[www]
user = www-data
group = www-data
listen = /run/phpfpm/{{ user.name }}.sock
listen.mode = 0666

pm = dynamic
pm.max_children = 5
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3

php_admin_value[error_log] = /proc/self/fd/2
php_admin_flag[log_errors] = on
