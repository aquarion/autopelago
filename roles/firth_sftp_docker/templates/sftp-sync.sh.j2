#!/bin/bash
# {{ ansible_managed }}
set -euo pipefail

DEFAULTS_FILE="/etc/sftp-sync.cnf"
USERS_CONF="{{ docker_root }}/sftp/etc/users.conf"
KEYS_CONF="{{ docker_root }}/sftp/etc/.keys-sync-tmp"
SFTP_DIR="{{ docker_root }}/sftp"
HOME_DIR="{{ docker_root }}/sftp/home"

mysql() {
    command mysql --defaults-file="$DEFAULTS_FILE" "$@"
}

dirty=$(mysql -sNe "SELECT dirty FROM sftp_sync WHERE id = 1;")

if [[ -z "$dirty" ]]; then
    echo "ERROR: sftp_sync row (id = 1) not found; cannot determine sync state. Has the table been migrated/seeded?" >&2
    exit 1
fi

# Always reconcile, regardless of the dirty flag: the flag only tracks
# pending *data* changes, not container recreation. If the sftp container
# is ever restarted/recreated, every OS account in it is gone, but nothing
# would mark a fresh dirty=1 - a dirty-gated sync would leave the container
# empty until the next unrelated data change. Reconciling is cheap and
# idempotent (create-sftp-user skips existing users, chpasswd/chown are
# no-ops when nothing changed), so just always run it. dirty is kept only
# to distinguish the log line below.
if [[ "$dirty" == "1" ]]; then
    echo "sftp-sync: dirty flag set, syncing users..."
else
    echo "sftp-sync: no pending changes, reconciling anyway..."
fi

# Write users.conf
mysql -sNe "SELECT CONCAT(username, ':', COALESCE(NULLIF(password, ''), '*'), ':e:', uid, ':', gid) FROM sftp_users;" \
    > "$USERS_CONF"

# Reconcile users in the running container; existing users are skipped by create-sftp-user.
# Any failure here aborts the sync (set -e is active).
# NOTE: each docker compose exec below is explicitly given "< /dev/null" -
# without it, the exec'd process inherits this loop's own stdin (the
# redirected $USERS_CONF), and can consume more of the file than the loop's
# own `read` expects, silently truncating the loop to its first line. This
# was invisible while there was ever only one row to reconcile.
while IFS= read -r line; do
    username="${line%%:*}"
    hash="${line#*:}"; hash="${hash%%:*}"
    # create-sftp-user logs its raw argument (including the password hash) to
    # stdout on every call; capture it instead of letting it flow straight to
    # the journal, and only print it if the call actually failed - with the
    # hash redacted even then, since failing ticks are the ones most likely
    # to get copied into a chat or issue.
    if ! output=$(docker compose -f "$SFTP_DIR/docker-compose.yml" exec -T sftp \
            /usr/local/bin/create-sftp-user "$line" < /dev/null 2>&1); then
        echo "ERROR: create-sftp-user failed for user: $username" >&2
        echo "${output//"$hash"/<redacted>}" >&2
        exit 1
    fi
done < "$USERS_CONF"

# Verify that every users.conf entry resolves to an OS account inside the container.
while IFS=':' read -r username _; do
    if ! docker compose -f "$SFTP_DIR/docker-compose.yml" exec -T sftp \
            getent passwd "$username" < /dev/null > /dev/null; then
        echo "ERROR: User '$username' not found in SFTP container after sync. Check container logs." >&2
        exit 1
    fi
done < "$USERS_CONF"

# Sync authorized_keys and ownership for each user home.
# NOTE: mysql's output is written to a file first, not read via a
# `< <(mysql ...)` process substitution - a failure inside a process
# substitution is invisible to `set -e` (the loop just sees whatever
# partial output arrived, if any, and the script reports success either
# way). Writing to a file first means a failed query aborts the script
# here, before any (possibly partial) data reaches the loop below.
mysql -sNe "SELECT username, uid, gid, COALESCE(public_key, '') FROM sftp_users;" \
    > "$KEYS_CONF"

while IFS=$'\t' read -r username uid gid public_key; do
    user_home="$HOME_DIR/$username"
    ssh_dir="$HOME_DIR/$username/.ssh"
    auth_keys="$ssh_dir/authorized_keys"

    mkdir -p "$user_home"
    # The chroot directory itself must stay root:root, not-group/other-writable,
    # or sshd rejects it post-auth ("bad ownership or modes for chroot directory")
    # and drops the connection before the SFTP subsystem opens - this is sshd's
    # requirement, not atmoz/sftp's, so it holds regardless of image version.
    # Only content *under* the home dir should be user-owned.
    chown root:root "$user_home"
    chmod 755 "$user_home"

    # Users need somewhere writable inside the chroot - the chroot root itself
    # can't be it. Bind mounts / PHP sites (if configured) provide their own
    # writable subdirs, but every user gets this one regardless so plain
    # SFTP-only accounts aren't left unable to upload anything.
    mkdir -p "$user_home/files"

    find "$user_home" -mindepth 1 -maxdepth 1 -exec chown -R "$uid:$gid" {} +

    if [[ -n "$public_key" ]]; then
        mkdir -p "$ssh_dir"
        echo "$public_key" > "$auth_keys"
        chown -R "$uid:$gid" "$ssh_dir"
        chmod 700 "$ssh_dir"
        chmod 600 "$auth_keys"
    else
        rm -f "$auth_keys"
    fi
done < "$KEYS_CONF"

# Update passwords for all users (handles existing users that were skipped above)
password_updates="$(mysql -sNe "SELECT CONCAT(username, ':', password) FROM sftp_users WHERE password IS NOT NULL AND password <> '';")"

if [[ -n "$password_updates" ]]; then
    usernames="$(printf '%s\n' "$password_updates" | cut -d: -f1 | paste -sd, -)"
    if ! printf '%s\n' "$password_updates" | \
            docker compose -f "$SFTP_DIR/docker-compose.yml" exec -T sftp chpasswd -e; then
        echo "ERROR: password sync failed for one or more users: $usernames" >&2
        exit 1
    fi
fi

# Reload sshd to pick up account/password updates without recreating the container.
if ! docker compose -f "$SFTP_DIR/docker-compose.yml" exec -T sftp \
        sh -c 'pkill -HUP sshd 2>/dev/null || kill -HUP 1'; then
    echo "ERROR: sshd reload failed" >&2
    exit 1
fi

mysql -e "UPDATE sftp_sync SET dirty = 0, last_synced_at = NOW() WHERE id = 1;"

echo "sftp-sync: sync complete."
